# Server Port (Default: 3000)
PORT=3000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# Database Connection (PostgreSQL / Supabase Free)
DATABASE_URL=postgres://postgres:your_password@db.supabase.co:5432/postgres

# Storage Driver: 'local' (filesystem) or 'github' (GitHub Releases)
STORAGE_DRIVER=github

# GitHub Release Storage Settings (Server-side only)
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPOSITORY=your_repository_name

# Admin Initial Credentials (Server-side only)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_THIS_IN_PRODUCTION!
